# ── Supabase Configuration ───────────────────────────────────────────────────
# From Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── Admin Auth ───────────────────────────────────────────────────────────────
# Default root admin credentials seeded on first startup
ROOT_ADMIN_USERNAME=admin
ROOT_ADMIN_PASSWORD=change-me-in-production

# Random 32+ character string used to sign admin session cookies
ADMIN_JWT_SECRET=generate-a-random-32-character-secret-key
